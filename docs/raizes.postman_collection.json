{
  "info": {
    "name": "Raízes do Nordeste - fluxo completo",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Executar a coleção inteira na ordem, após migrations/seed, com API e gateway mock ativos. Cada execução cadastra seu próprio cliente. A conta é anonimizada ao final."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "senha",
      "value": "Demo@123456"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "T01 Cadastrar cliente",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const id = pm.variables.replaceIn('{{$guid}}');",
                  "pm.collectionVariables.set('runId', id);",
                  "pm.collectionVariables.set('emailTeste', 'teste-' + id + '@example.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Contrato perfil', () => pm.expect(body[\"perfil\"]).to.eql(\"CLIENTE\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/auth/cadastro",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Cliente de teste\",\n  \"email\": \"{{emailTeste}}\",\n  \"senha\": \"{{senha}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "T02 Login cliente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('token', body.accessToken);",
                  "pm.test('Contrato tokenType', () => pm.expect(body[\"tokenType\"]).to.eql(\"Bearer\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailTeste}}\",\n  \"senha\": \"{{senha}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "T03 Login administrador",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('adminToken', body.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "url": "{{baseUrl}}/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@raizes.local\",\n  \"senha\": \"{{senha}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
