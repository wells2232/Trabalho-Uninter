[
  {
    "id": "T01",
    "group": "Auth",
    "name": "Cadastrar cliente",
    "method": "POST",
    "path": "/auth/cadastro",
    "status": 201,
    "noauth": true,
    "body": {
      "nome": "Cliente de teste",
      "email": "{{emailTeste}}",
      "senha": "{{senha}}"
