{
  "name": "raizes-do-nordeste",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,mock,web \"npm run dev:api\" \"npm run mock\" \"npm run dev:web\"",
    "dev:api": "node --env-file-if-exists=.env backend/src/server.js",
    "dev:web": "vite frontend --host 127.0.0.1",
    "start": "node --env-file-if-exists=.env backend/src/server.js",
    "mock": "node --env-file-if-exists=.env backend/src/infrastructure/payment-server.js",
    "db:migrate": "node --env-file-if-exists=.env backend/scripts/migrate.js",
    "db:seed": "node --env-file-if-exists=.env backend/scripts/seed.js",
    "test": "node --test --test-concurrency=1 backend/test/*.test.js",
    "build": "vite build frontend",
    "docs": "node backend/scripts/export-docs.js",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.1.0",
    "vite": "^7.0.0"
  }
}
